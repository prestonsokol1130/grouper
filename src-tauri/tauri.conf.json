{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grouper",
  "version": "0.1.0",
  "identifier": "com.grouper.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "manager",
        "create": false,
        "title": "Grouper",
        "url": "index.html?window=manager",
        "width": 960,
        "height": 640,
        "transparent": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "launchpad",
        "create": false,
        "title": "Grouper",
        "url": "index.html?window=launchpad",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "noRedirectionBitmap": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "flyout",
        "create": false,
        "title": "Grouper",
        "url": "index.html?window=flyout",
        "width": 360,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "noRedirectionBitmap": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/cache/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
